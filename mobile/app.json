{
  "expo": {
    "name": "Rememberly",
    "slug": "rememberly-mobile",
    "version": "0.1.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "ios": {
      "supportsTablet": true
    }
  }
}
