{
  "name": "rememberly-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": "^24.3.0"
  },
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "test:config": "node --experimental-strip-types --test --test-isolation=none tests/api-config.test.ts",
    "test:sessions": "node --experimental-strip-types --test --test-isolation=none tests/session.test.ts",
    "format:check": "prettier --check .",
    "export:native": "expo export --platform ios --platform android --output-dir dist"
  },
  "dependencies": {
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "prettier": "3.8.1",
    "typescript": "~6.0.3"
  }
}
