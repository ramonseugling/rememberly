{
  "name": "rememberly-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": "^24.3.0"
  },
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "test:config": "node --experimental-strip-types --test --test-isolation=none tests/api-config.test.ts",
    "test:sessions": "node --experimental-strip-types --test --test-isolation=none tests/session.test.ts",
    "format:check": "prettier --check .",
    "export:native": "expo export --platform ios --platform android --output-dir dist",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/quicksand": "^0.4.1",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.69.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "^15.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "prettier": "3.8.1",
    "typescript": "~6.0.3"
  }
}
